#!/usr/bin/env bash

# Source this file once at the top of a test runner script to set up the
# shared build environment for the test suite.
#
# Idempotent — if $build_env_root is already set the file returns immediately,
# so it is safe to source from multiple scripts in the same shell session.
#
# After sourcing, the isolation provider is loaded and the repo is cloned into
# the test workspace. The provider's cleanup() function is registered as an
# EXIT trap, so the environment is torn down automatically when the shell exits.
#
# Provided functions:
#   load_isolation_provider  — sources a provider script and validates its interface
#   is_root_environment      — returns 0 if the current shell is the one that sourced this file
#
# Required environment:
#   ARTIFACTS_DIR  — directory for test result artifact files
#
# Exported variables (available to all sourced scripts after this file):
#   artifacts_dir        — canonicalised $ARTIFACTS_DIR
#   build_env_root       — PID of the shell that sourced this file
#   project_root         — absolute path to the git repository root
#   repo_name            — basename of $project_root
#   git_branch           — current branch name
#   git_sha              — HEAD commit SHA
#   repo_workspace       — clone of the repo inside the test workspace
#   guest_mount_root     — host-side path mounted into the guest as /ci
#   guest_workspace      — guest-side path to the test workspace
#   guest_repo_workspace — guest-side path to the repo clone
#   guest_artifacts_dir  — guest-side path to the artifacts directory
#
# The following variables and functions are provided by the isolation provider
# (sourced via load_isolation_provider):
#   $test_workspace      — host path to the scratch workspace directory
#   provider_run()       — start the isolated environment
#   provider_stop()      — stop the isolated environment
#   provider_remove()    — delete the isolated environment
#   provider_exec()      — run a command inside the environment
#   provider_cleanup()   — full teardown; registered as the EXIT trap

set -Eeuo pipefail

# Guard against double-sourcing. If $build_env_root is already set this file
# has already been initialised in the current session; return immediately.
if [[ -n "${build_env_root:-}" ]]; then
	return 0
fi

# Returns 0 if the calling shell is the shell that originally sourced this
# file, i.e. the root build environment shell and not a subshell.
is_root_environment() {
	[[ -n "${build_env_root}" ]] && [[ "${build_env_root}" == "${BASHPID}" ]]
}

# Source an isolation provider script and validate that it exported the
# required interface. Exits with an error if any required function or variable
# is missing after sourcing.
#
# Arguments:
#   $1  — path to the provider script (required)
#
# Required interface after sourcing:
#   test_workspace        — set by the provider
#   run_environment()
#   stop_environment()
#   delete_environment()
#   do_exec()
#   cleanup()
load_isolation_provider() {
	local provider="${1?"Missing argument path to provider"}"
	source "${provider}" "${repo_name}"

	if [[ -z "${test_workspace:-}" ]]; then
		echo "error: isolation provider did not set test_workspace" >&2
		exit 1
	fi

	if ! declare -f provider_run >/dev/null; then
		echo "error: isolation provider did not define run_environment" >&2
		exit 1
	fi

	if ! declare -f provider_stop >/dev/null; then
		echo "error: isolation provider did not define stop_environment" >&2
		exit 1
	fi

	if ! declare -f provider_remove >/dev/null; then
		echo "error: isolation provider did not define delete_environment" >&2
		exit 1
	fi

	if ! declare -f provider_exec >/dev/null; then
		echo "error: isolation provider did not define do_exec" >&2
		exit 1
	fi

	if ! declare -f provider_cleanup >/dev/null; then
		echo "error: isolation provider did not define cleanup" >&2
		exit 1
	fi
}

export artifacts_dir="${ARTIFACTS_DIR?:"Missing required environment variable ARTIFACTS_DIR"}"
readonly artifacts_dir

# Record the PID of this shell as the root environment. Used by
# is_root_environment() and by test_group.env to validate subshell execution.
export build_env_root="$$"
readonly build_env_root

# Resolve the git repository root from the location of this script, regardless
# of the working directory the caller was in.
read -r project_root < <(cd "$(cd "$(dirname "${BASH_SOURCE[0]}")" && git rev-parse --show-toplevel)" && pwd)
export project_root
readonly project_root

# Strip the leading path to get the bare repository name (e.g. /home/user/myrepo → myrepo).
export repo_name="${project_root##*/}"
readonly repo_name

read -r git_branch < <(cd "${project_root}" && git branch --show-current)
export git_branch
readonly git_branch

read -r git_sha < <(cd "${project_root}" && git rev-parse HEAD)
export git_sha
readonly git_sha

# Load the isolation provider. This defines test_workspace, run_environment,
# stop_environment, delete_environment, do_exec, and cleanup.
# cleanup() is registered as an EXIT trap immediately after so that partial
# initialisation is still torn down if anything below this line fails.
: "${ISOLATION_PROVIDER:=util/isolation/bare}"
# The following providers can be use for namespace/hardware isolation
# load_isolation_provider "util/isolation/tart"
# load_isolation_provider "util/isolation/docker"
# load_isolation_provider "util/isolation/lima"
load_isolation_provider "${ISOLATION_PROVIDER}"
trap cleanup EXIT

export repo_workspace="${test_workspace}/${repo_name}"
readonly repo_workspace

# Clone the repo into the test workspace if it is not already there.
# --single-branch limits fetch traffic to the current branch only.
if [[ ! -d "${repo_workspace}" ]]; then
	git clone --single-branch --branch "${git_branch}" "file://${project_root}" "${repo_workspace}"
fi

# guest_mount_root is the host-side directory that is bind-mounted into the
# guest VM as /ci. All guest-side paths are derived from it.
export guest_mount_root="${project_root}/ci"
readonly guest_mount_root

# guest_workspace is the guest-side equivalent of $test_workspace, derived by
# replacing the host prefix with the guest mount point.
export guest_workspace="${guest_mount_root}/${test_workspace##*/}"
readonly guest_workspace

export guest_repo_workspace="${guest_workspace}/${repo_workspace##*/}"
readonly guest_repo_workspace

export guest_artifacts_dir="${guest_mount_root}/artifacts"
readonly guest_artifacts_dir

# Merge main into the workspace clone to catch conflicts before running tests.
# Runs in a subshell to avoid changing the working directory of the caller.
(
	cd "${repo_workspace}"
	git pull --no-rebase --depth 1 origin main
)
