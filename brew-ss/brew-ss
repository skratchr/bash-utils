#!/usr/bin/env bash
# brew-ss
#
# Generates a script like a snapshot of current brew packages.

set -euo pipefail

if ! command -v brew &>/dev/null; then
  echo "brew not found"
  exit 1
fi

BREW_FORMULAE=()
BREW_CASKS=()

while IFS= read -r formula; do
  BREW_FORMULAE+=("$formula")
done < <(brew leaves 2>/dev/null || true)
readonly BREW_FORMULAE

while IFS= read -r cask; do
  BREW_CASKS+=("$cask")
done < <(brew list --cask 2>/dev/null || true)
readonly BREW_CASKS

echo "#!/usr/bin/env bash"
echo "# restore.sh — generated by brew-ss on $(date '+%Y-%m-%d %H:%M %Z')"
echo "#"
echo "# Restores brew formulae and casks. Review before running."
echo ""
echo "set -euo pipefail"
echo ""
echo "if ! command -v brew &>/dev/null; then"
echo "  echo \"brew not found. Install Homebrew first, then rerun this script.\" >&2"
echo "  exit 1"
echo "fi"
echo ""
echo "brew update"

echo ""
echo "# *************************"
echo "# ***** Formulae list *****"
echo "# *************************"
echo ""

if [[ ${#BREW_FORMULAE[@]} -gt 0 ]]; then
  echo "brew install \\"
  last=$((${#BREW_FORMULAE[@]} - 1))
  for i in "${!BREW_FORMULAE[@]}"; do
    [[ $i -eq ${last} ]] && echo "  ${BREW_FORMULAE[$i]}" || echo "  ${BREW_FORMULAE[$i]} \\"
  done
  unset last
fi

echo ""
echo "# *************************"
echo "# ******* Cask list *******"
echo "# *************************"
echo ""

if [[ ${#BREW_CASKS[@]} -gt 0 ]]; then
  echo "brew install --cask \\"
  last=$((${#BREW_CASKS[@]} - 1))
  for i in "${!BREW_CASKS[@]}"; do
    [[ $i -eq ${last} ]] && echo "  ${BREW_CASKS[$i]}" || echo "  ${BREW_CASKS[$i]} \\"
  done
  unset last
fi
