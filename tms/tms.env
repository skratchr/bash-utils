# Projects are indexed — each index ties together a directory, URL, and the
# windows it appears in. An index present in project_code but absent from
# project_debg or project_logs simply won't create that window.

# Filesystem paths for each project, referenced by index in all maps below.
declare -a project_dirs=(
  "${HOME}/tmux-session"
)

# Remote URLs used to clone a project if its directory does not exist.
# Leave an index unset or empty to skip cloning for that project.
# Any git-compatible remote works: HTTPS, SSH, Forgejo, GitLab, etc.
declare -A project_urls=(
  [0]="https://github.com/skratchr/tmux-session"
)

# One session per project. Value is the session name shown in tmux.
declare -A project_code=(
  [0]="tmux-session"
)

# Adds a debg window to the project session, split into N vertical panes.
# Value is the pane count: 1 for single, 2 splits top/bottom, etc.
declare -A project_debg=(
  [0]="1"
)

# Adds a logs window to the project session. Separate multiple commands
# with '|' to split into panes, one command per pane, up to 4.
declare -A project_logs=(
)

# Additional windows in the shared 'logs' session for system-level streams.
# On macOS use 'log show' or 'log stream'; on Linux use 'journalctl'.
declare -A unified_logs=(
)

# Each entry creates a window in the 'ssh' session.
# Values must match a host alias defined in ~/.ssh/config.
declare -a sshs=(
  "pi-hole"
)

# Each entry creates a window in the 'llm' session with remain-on-exit
# enabled — panes stay open if a process crashes.
# Key is the window name, value is the command to run.
declare -A llms=(
  ["ollama"]="ollama serve"
)

# Panes inside a single 'agents' window in the 'llm' session.
# Format is "title:command" — title appears in the pane border.
declare -a llm_agents=(
)
